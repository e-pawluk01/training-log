# Same Supabase project as OS (sign-in accounts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same Google OAuth credentials as OS (writes to the Sheets)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# People: their Supabase login email and their "Training Log" Sheet ID
ERYK_EMAIL=
ERYK_SHEET_ID=
ALEX_EMAIL=
ALEX_SHEET_ID=

# Local dev only: skip sign-in as this person (ignored in production).
# Without the Google vars, local dev logs to .data/<person>.json instead of the Sheet.
# DEV_PERSON=eryk
