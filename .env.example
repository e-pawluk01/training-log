# Google OAuth credentials, the same values as OS (reads and writes the Sheets)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Signs the login cookie. Any long random string, e.g. from: openssl rand -hex 32
AUTH_SECRET=

# People: the password for this app, and their "Training Log" Sheet ID
ERYK_PASSWORD=
ERYK_SHEET_ID=
ALEX_PASSWORD=
ALEX_SHEET_ID=

# Local dev only: skip sign-in as this person (ignored in production).
# Without the Google vars, local dev logs to .data/<person>.json instead of the Sheet.
# DEV_PERSON=eryk
